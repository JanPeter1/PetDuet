# ESP-IDF Default SDK Configuration for PetDuet ESP32-2432S028R (CYD)
CONFIG_IDF_TARGET="esp32"

# 4MB SPI Flash & Custom A/B OTA + SPIFFS Partition Table
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHSIZE="4MB"
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# Bootloader Rollback Protection for A/B OTA
CONFIG_BOOTLOADER_APP_ROLLBACK_ENABLE=y

# FreeRTOS 1ms Tick & Larger Main Task Stack (for LVGL + HTTP/OTA)
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=12288

# HTTP Server & Client Buffers
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=512
CONFIG_ESP_HTTPS_OTA_ALLOW_HTTP=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y

# LVGL Configuration (uses main/lv_conf.h)
CONFIG_LV_CONF_SKIP=n
